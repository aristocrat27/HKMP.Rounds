<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<HollowKnightManaged>D:\SteamLibrary\steamapps\common\Hollow Knight\hollow_knight_Data\Managed</HollowKnightManaged>
		<ModsDir>$(HollowKnightManaged)\Mods</ModsDir>
		<RootNamespace>HKMP.Rounds</RootNamespace>
		<AssemblyName>HKMP.Rounds</AssemblyName>
		<TargetFramework>net472</TargetFramework>
		<AssemblyTitle>HKMP.Rounds</AssemblyTitle>
		<Product>HKMP.Rounds</Product>
		<Description>HKMP round and statistics addon</Description>
		<AssemblyVersion>1.1.0.0</AssemblyVersion>
		<FileVersion>1.1.0.0</FileVersion>
		<OutputPath>bin\$(Configuration)\</OutputPath>
		<LangVersion>latest</LangVersion>
	</PropertyGroup>
	<ItemGroup>
		<Reference Include="Assembly-CSharp">
			<HintPath>$(HollowKnightManaged)\Assembly-CSharp.dll</HintPath>
		</Reference>
		<Reference Include="HKMP">
		  <HintPath>..\SteamLibrary\steamapps\common\Hollow Knight\hollow_knight_Data\Managed\Mods\HKMP\HKMP.dll</HintPath>
		</Reference>
		<Reference Include="MMHOOK_Assembly-CSharp">
			<HintPath>$(HollowKnightManaged)\MMHOOK_Assembly-CSharp.dll</HintPath>
		</Reference>
		<Reference Include="MonoMod.RuntimeDetour">
			<HintPath>$(HollowKnightManaged)\MonoMod.RuntimeDetour.dll</HintPath>
		</Reference>
		<Reference Include="netstandard">
			<HintPath>$(HollowKnightManaged)\netstandard.dll</HintPath>
		</Reference>
		<Reference Include="Newtonsoft.Json">
			<HintPath>$(HollowKnightManaged)\Newtonsoft.Json.dll</HintPath>
		</Reference>
		<Reference Include="PlayMaker">
		  <HintPath>..\SteamLibrary\steamapps\common\Hollow Knight\hollow_knight_Data\Managed\PlayMaker.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine">
			<HintPath>$(HollowKnightManaged)\UnityEngine.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine.CoreModule">
			<HintPath>$(HollowKnightManaged)\UnityEngine.CoreModule.dll</HintPath>
		</Reference>
		<Reference Include="UnityEngine.Physics2DModule">
			<HintPath>$(HollowKnightManaged)\UnityEngine.Physics2DModule.dll</HintPath>
		</Reference>
	</ItemGroup>
	<Target Name="ExportMod" AfterTargets="Build">
		<MakeDir Directories="$(ModsDir)\HKMP.Rounds" />
		<Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModsDir)\HKMP.Rounds" SkipUnchangedFiles="true" />
		<Copy SourceFiles="$(TargetDir)$(AssemblyName).pdb" DestinationFolder="$(ModsDir)\HKMP.Rounds" SkipUnchangedFiles="true" Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" />
	</Target>
</Project>
